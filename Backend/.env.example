# ==============================================================================
# AI Travel Planner - Backend Environment Configuration
# Copy this file to .env and fill in your own credentials/API keys.
# NEVER commit .env to Git.
# ==============================================================================

# Flask Server Configuration
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=your_super_secret_session_key_here
JWT_SECRET_KEY=your_jwt_secret_signing_key_here

# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/travel_planner_db

# ==============================================================================
# OpenRouter AI
# ==============================================================================
# Create your key at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary + fallback model. You can change these without changing Python code.
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_FALLBACK_MODEL=google/gemini-3.7-flash

OPENROUTER_TEMPERATURE=0.3
OPENROUTER_MAX_OUTPUT_TOKENS=3000
OPENROUTER_TIMEOUT=90
OPENROUTER_HTTP_REFERER=http://localhost:5000
OPENROUTER_APP_TITLE=AI Travel Planner

# ==============================================================================
# Geoapify API (geocoding, nearby places/hotels)
# ==============================================================================
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ==============================================================================
# OpenWeather API (destination forecast)
# ==============================================================================
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional Hotel API
HOTEL_API_KEY=your_hotel_api_key_here
